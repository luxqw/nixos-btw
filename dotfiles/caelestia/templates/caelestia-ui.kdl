// Caelestia user template: ~/.local/state/caelestia/theme/caelestia-ui.kdl, passed to
// zellij as --theme caelestia-ui by zellij-scratch/zellij-pick in Hyprland (home.nix).
// Port of ../../zellij/noctalia-ui.kdl; Caelestia has no colour filters, so the
// dimmed text is on-surface-variant instead of `darken 30`.
themes {
  caelestia-ui {
    text_unselected {
      base "#{{ onSurfaceVariant.hex }}"
      background "#{{ surface.hex }}"
      emphasis_0 "#{{ primary.hex }}"
      emphasis_1 "#{{ primary.hex }}"
      emphasis_2 "#{{ tertiary.hex }}"
      emphasis_3 "#{{ error.hex }}"
    }
    text_selected {
      base "#{{ onSurface.hex }}"
      background "#{{ surfaceContainerHigh.hex }}"
      emphasis_0 "#{{ primary.hex }}"
      emphasis_1 "#{{ primary.hex }}"
      emphasis_2 "#{{ tertiary.hex }}"
      emphasis_3 "#{{ error.hex }}"
    }
    ribbon_unselected {
      base "#{{ onSurfaceVariant.hex }}"
      background "#{{ surfaceContainerHigh.hex }}"
      emphasis_0 "#{{ primary.hex }}"
      emphasis_1 "#{{ onSurface.hex }}"
      emphasis_2 "#{{ tertiary.hex }}"
      emphasis_3 "#{{ error.hex }}"
    }
    ribbon_selected {
      base "#{{ onPrimary.hex }}"
      background "#{{ primary.hex }}"
      emphasis_0 "#{{ surface.hex }}"
      emphasis_1 "#{{ surface.hex }}"
      emphasis_2 "#{{ surface.hex }}"
      emphasis_3 "#{{ error.hex }}"
    }
    table_title {
      base "#{{ primary.hex }}"
      background "#{{ surface.hex }}"
      emphasis_0 "#{{ tertiary.hex }}"
      emphasis_1 "#{{ onSurface.hex }}"
      emphasis_2 "#{{ tertiary.hex }}"
      emphasis_3 "#{{ error.hex }}"
    }
    table_cell_unselected {
      base "#{{ onSurface.hex }}"
      background "#{{ surface.hex }}"
      emphasis_0 "#{{ primary.hex }}"
      emphasis_1 "#{{ tertiary.hex }}"
      emphasis_2 "#{{ onSurfaceVariant.hex }}"
      emphasis_3 "#{{ error.hex }}"
    }
    table_cell_selected {
      base "#{{ onSurface.hex }}"
      background "#{{ surfaceContainerHigh.hex }}"
      emphasis_0 "#{{ primary.hex }}"
      emphasis_1 "#{{ tertiary.hex }}"
      emphasis_2 "#{{ onSurfaceVariant.hex }}"
      emphasis_3 "#{{ error.hex }}"
    }
    list_unselected {
      base "#{{ onSurface.hex }}"
      background "#{{ surface.hex }}"
      emphasis_0 "#{{ primary.hex }}"
      emphasis_1 "#{{ tertiary.hex }}"
      emphasis_2 "#{{ onSurfaceVariant.hex }}"
      emphasis_3 "#{{ error.hex }}"
    }
    list_selected {
      base "#{{ onSurface.hex }}"
      background "#{{ surfaceContainerHigh.hex }}"
      emphasis_0 "#{{ primary.hex }}"
      emphasis_1 "#{{ tertiary.hex }}"
      emphasis_2 "#{{ onSurfaceVariant.hex }}"
      emphasis_3 "#{{ error.hex }}"
    }
    frame_unselected {
      base "#{{ outline.hex }}"
      background "#{{ surface.hex }}"
      emphasis_0 "#{{ primary.hex }}"
      emphasis_1 "#{{ onSurfaceVariant.hex }}"
      emphasis_2 "#{{ tertiary.hex }}"
      emphasis_3 "#{{ error.hex }}"
    }
    frame_selected {
      base "#{{ primary.hex }}"
      background "#{{ surface.hex }}"
      emphasis_0 "#{{ tertiary.hex }}"
      emphasis_1 "#{{ onSurface.hex }}"
      emphasis_2 "#{{ tertiary.hex }}"
      emphasis_3 "#{{ error.hex }}"
    }
    frame_highlight {
      base "#{{ tertiary.hex }}"
      background "#{{ surface.hex }}"
      emphasis_0 "#{{ primary.hex }}"
      emphasis_1 "#{{ onSurface.hex }}"
      emphasis_2 "#{{ tertiary.hex }}"
      emphasis_3 "#{{ error.hex }}"
    }
    exit_code_success {
      base "#{{ term2.hex }}"
      background "#{{ surface.hex }}"
      emphasis_0 "#{{ primary.hex }}"
      emphasis_1 "#{{ onSurface.hex }}"
      emphasis_2 "#{{ tertiary.hex }}"
      emphasis_3 "#{{ error.hex }}"
    }
    exit_code_error {
      base "#{{ term1.hex }}"
      background "#{{ surface.hex }}"
      emphasis_0 "#{{ primary.hex }}"
      emphasis_1 "#{{ onSurface.hex }}"
      emphasis_2 "#{{ tertiary.hex }}"
      emphasis_3 "#{{ error.hex }}"
    }
    multiplayer_user_colors {
      player_1 "#{{ primary.hex }}"
      player_2 "#{{ tertiary.hex }}"
      player_3 "#{{ term2.hex }}"
      player_4 "#{{ term3.hex }}"
      player_5 "#{{ term6.hex }}"
      player_6 "#{{ term5.hex }}"
      player_7 "#{{ term1.hex }}"
      player_8 "#{{ term4.hex }}"
      player_9 "#{{ secondary.hex }}"
      player_10 "#{{ onSurface.hex }}"
    }
  }
}
